{
  "rewrites": [
    { "source": "/g/:token",   "destination": "/index.html" },
    { "source": "/s/:code",    "destination": "/index.html" },
    { "source": "/rec",        "destination": "/rec.html" },
    { "source": "/handover",   "destination": "/handover.html" },
    { "source": "/r",          "destination": "/check.html" },
    { "source": "/r/:pin",     "destination": "/check.html" },
    { "source": "/check",      "destination": "/check.html" },
    { "source": "/check/:pin", "destination": "/check.html" }
  ]
}
